<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <WarnOn>3390</WarnOn>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <FsDocsLicenseLink>https://github.com/leonitousconforti/flip7/blob/main/LICENSE</FsDocsLicenseLink>
    <FsDocsReleaseNotesLink>https://github.com/leonitousconforti/flip7/blob/main/CHANGELOG.md</FsDocsReleaseNotesLink>
  </PropertyGroup>

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>Flip7</PackageId>
    <Description>The card game Flip 7 in F#: a rules engine that plays whole games, the odds a hand busts and what hitting it is worth, an exact search of the decision, strategies to play against, and inference of the strategy a player is using.</Description>
    <PackageTags>fsharp;flip7;card-game;simulation;probability</PackageTags>
    <!-- The package depends on the FSharp.Core it was built against, so build against the first
         one F# 10 shipped rather than this SDK's, which would force consumers onto it too. The
         terminal app and the tests keep the SDK's. -->
    <FSharpCoreImplicitPackageVersion>10.0.100</FSharpCoreImplicitPackageVersion>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <!-- Fable compiles a package from its F# sources rather than its assembly -->
    <Content Include="*.fsproj;**\*.fs" Exclude="obj\**;bin\**" PackagePath="fable\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Flip7.Test" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="ScoreBuckets.fs" />
    <Compile Include="Card.fs" />
    <Compile Include="Hand.fs" />
    <Compile Include="Deck.fs" />
    <Compile Include="Simulation.fs" />
    <Compile Include="Lookahead.fs" Condition="'$(FABLE_COMPILER)' != 'true'" />
    <Compile Include="Player.fs" />
    <Compile Include="Instant.fs" />
    <Compile Include="Strategy.fs" />
    <Compile Include="Timeline.fs" />
    <Compile Include="Persistence.fs" Condition="'$(FABLE_COMPILER)' != 'true'" />
    <Compile Include="Observation.fs" />
    <Compile Include="Inference.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FSharp.Control.AsyncSeq" Version="4.15.0" />
  </ItemGroup>

</Project>
